# =========================================================
# STORE 101 — Variabili d'ambiente (rinomina in .env.local)
# =========================================================

# URL pubblico dell'applicazione (senza slash finale)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chiave pubblica Stripe (sicura lato client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Chiavi segrete Stripe — SOLO LATO SERVER, MAI prefisso NEXT_PUBLIC_
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Opzionali — caricati nel DOM SOLO dopo consenso GDPR esplicito
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# =========================================================
# AREA ADMIN, CRM & SYNC CSV (SOLO LATO SERVER)
# =========================================================
ADMIN_EMAIL=admin@store101.it
ADMIN_PASSWORD=Store101Admin!2026
ADMIN_SESSION_SECRET=change_me_with_a_long_random_64_char_secret

# Opzionale — Supabase PostgreSQL (vedi supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
